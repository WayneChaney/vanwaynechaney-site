# Nothing sensitive in it, but there is no reason to publish the list of files
# kept out of the deploy.
/.gitignore
  X-Robots-Tag: noindex, nofollow

# Archived pages. Kept on disk for reference, kept out of search and out of
# what AI assistants read when deciding what this business does.
/archive/*
  X-Robots-Tag: noindex, nofollow
