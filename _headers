# Cloudflare Pages security headers.
# Some directives (frame-ancestors, X-Frame-Options, HSTS) only work as real HTTP
# headers and are ignored inside a <meta> tag, so they have to live here.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Verified 2026-09-22 against a server actually sending this header: 7 pages,
  # zero violations, Cal embed still loads on index and book, chat still renders.
  # Only two third parties execute or render anything here — Cal and Google Fonts.
  # The Vapi SDK was removed from live-demos.html the same day; do not re-add a
  # CDN origin without testing the pages again.
  # 🔴 'unsafe-inline' in script-src is a known weakness, not a decision. 27 inline
  # onclick= handlers have to move to addEventListener before it can come out.
  # cloudflareinsights.com is Cloudflare Web Analytics. Pages INJECTS that beacon
  # itself, so it does not appear anywhere in the source — the first CSP silently
  # blocked it and killed analytics. Caught by reading the live console, which is
  # the only place it was visible.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://app.cal.com https://cal.com; media-src 'self'; frame-src https://app.cal.com https://cal.com; connect-src 'self' https://app.cal.com https://api.cal.com https://cloudflareinsights.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'

# The missed-call calculator is fully self-contained and must never talk to a
# third party. connect-src 'none' makes exfiltration impossible rather than
# merely unintended.
/tools/missed-call/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  X-Frame-Options: DENY
  Cache-Control: public, max-age=0, must-revalidate

/tools/missed-call/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /tools/missed-call/

# The six real-estate tools are the free REIA lead magnet: unlisted, never priced.
# They were returning 200 with NO X-Robots-Tag, and robots.txt says Allow: /, so
# Google was free to index the download pages and hand the magnet to anyone.
# "Unlisted" has to be a header, not an intention.
# 🔴 `/dl-*` did NOT match on Cloudflare Pages — verified live, while the
# identically shaped `/archive/*` rule did. Listed explicitly instead of
# guessing at the glob. Each page also carries a robots meta tag.
/dl-apr-5k1x
  X-Robots-Tag: noindex, nofollow

/dl-apr-5k1x.html
  X-Robots-Tag: noindex, nofollow

/dl-cb-4n2k
  X-Robots-Tag: noindex, nofollow

/dl-cb-4n2k.html
  X-Robots-Tag: noindex, nofollow

/dl-reb-9x3k
  X-Robots-Tag: noindex, nofollow

/dl-reb-9x3k.html
  X-Robots-Tag: noindex, nofollow

